# --- Application ---
APP_ENV=local
LOG_LEVEL=INFO
API_BASE_PATH=/api/v1
CORS_ORIGINS=http://localhost:5173

# --- Database ---
DATABASE_URL=postgresql+psycopg://scholarmind:scholarmind@localhost:5432/scholarmind
POSTGRES_USER=scholarmind
POSTGRES_PASSWORD=scholarmind
POSTGRES_DB=scholarmind

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- Auth ---
JWT_SECRET=change-me-in-every-environment
JWT_REFRESH_SECRET=change-me-too
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7
ADMIN_EMAILS=
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- LLM / embeddings ---
LLM_API_KEY=
LLM_MODEL=claude-sonnet-5
LLM_MAX_TOKENS=2048
LLM_TEMPERATURE=0
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536
RERANK_ENABLED=false
RERANK_MODEL=

# --- Retrieval defaults ---
RETRIEVAL_TOP_K=20
RETRIEVAL_CANDIDATES=100
RETRIEVAL_RRF_K=60
RETRIEVAL_CHUNK_TOKENS=500
RETRIEVAL_CHUNK_OVERLAP=80

# --- Ingestion ---
INGESTION_ENABLED=false
INGESTION_USER_AGENT=ScholarMindBot/1.0 (+https://example.org/scholarmind)
INGESTION_MAX_BYTES=5242880
INGESTION_TIMEOUT_SECONDS=20
INGESTION_MIN_DELAY_SECONDS=5
INGESTION_MAX_REDIRECTS=3
INGESTION_DEFAULT_CADENCE_HOURS=168

# --- Rate limits (per user, per window) ---
RATE_LIMIT_READ_PER_MIN=240
RATE_LIMIT_WRITE_PER_MIN=60
RATE_LIMIT_ASSISTANT_PER_MIN=20
RATE_LIMIT_ASSISTANT_PER_DAY=200
RATE_LIMIT_REFRESH_PER_MIN=5

# --- Observability ---
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=
LOG_JSON=true

# --- Frontend (public; safe to expose) ---
VITE_API_BASE_URL=http://localhost:8000/api/v1
